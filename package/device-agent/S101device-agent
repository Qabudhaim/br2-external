#!/bin/sh

DAEMON=/usr/bin/device-agent
PIDFILE=/var/run/device-agent.pid

wait_for_network()
{
    logger "device-agent: waiting for network"

    for i in $(seq 1 30); do
        if ip -4 addr show wlan0 | grep -q "inet "; then
            logger "device-agent: network ready"
            return 0
        fi

        sleep 1
    done

    logger "device-agent: timeout waiting for network"
    return 1
}

start()
{
    echo "Starting device-agent..."

    if pidof device-agent >/dev/null; then
        echo "device-agent already running"
        return 0
    fi

    wait_for_network || return 1

    "$DAEMON" &
    echo $! > "$PIDFILE"
}

stop()
{
    echo "Stopping device-agent..."

    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")"
        rm -f "$PIDFILE"
    else
        killall device-agent 2>/dev/null
    fi
}

restart()
{
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0